# Cloudflare R2 (see SETUP.md)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=second-show

# Your password for /admin. Use at least 12 characters.
ADMIN_PASSWORD=

# Long random string: run `openssl rand -hex 32`
SESSION_SECRET=

# Comma-separated site addresses allowed to upload, used only by `npm run setup:r2`
SITE_ORIGINS=http://localhost:3000

# Optional. These defaults keep you inside R2's free 10 GB.
# PUBLIC_UPLOADS=open        # set to "closed" to accept uploads from admin only
# MAX_TOTAL_GB=9.5           # nobody can upload past this total
# MAX_PUBLIC_FILE_GB=4       # largest file a member of the public can send
# MAX_PENDING=10             # submissions waiting for review before the door closes
# MAX_ACTIVE_PUBLIC_UPLOADS=5

# Only for local testing against MinIO
# R2_ENDPOINT=http://127.0.0.1:9000
