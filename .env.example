# Your password for /admin. Use at least 12 characters.
ADMIN_PASSWORD=

# Long random string: run `openssl rand -hex 32`
SESSION_SECRET=

# Vercel adds the Blob setting when you connect a Blob store (see SETUP.md).
# Without it, local development keeps the catalogue in a .data folder.

# Optional
# PUBLIC_UPLOADS=open        # set to "closed" to accept films from admin only
# MAX_PENDING=10             # submissions waiting for review before the door closes
# MAX_OPEN_REPORTS=50
